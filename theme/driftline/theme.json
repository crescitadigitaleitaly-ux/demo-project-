{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "720px", "wideSize": "1320px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "base", "name": "White", "color": "#ffffff" },
        { "slug": "mist", "name": "Mist", "color": "#f4f4f2" },
        { "slug": "line", "name": "Line", "color": "#e4e4e1" },
        { "slug": "soft", "name": "Soft ink", "color": "#595957" },
        { "slug": "contrast", "name": "Ink", "color": "#0d0d0d" },
        { "slug": "accent", "name": "Ochre", "color": "#9a6212" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "poppins",
          "name": "Poppins",
          "fontFamily": "Poppins, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            { "fontFamily": "Poppins", "fontWeight": "300", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-latin-300-normal.woff2"] },
            { "fontFamily": "Poppins", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-latin-400-normal.woff2"] },
            { "fontFamily": "Poppins", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-latin-500-normal.woff2"] },
            { "fontFamily": "Poppins", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-latin-600-normal.woff2"] },
            { "fontFamily": "Poppins", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-latin-700-normal.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "tiny", "name": "Tiny", "size": "0.72rem", "fluid": false },
        { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "body", "name": "Body", "size": "1rem", "fluid": false },
        { "slug": "lead", "name": "Lead", "size": "1.5rem", "fluid": { "min": "1.2rem", "max": "1.75rem" } },
        { "slug": "title", "name": "Title", "size": "2.2rem", "fluid": { "min": "1.5rem", "max": "2.4rem" } },
        { "slug": "display", "name": "Display", "size": "5rem", "fluid": { "min": "2rem", "max": "5.25rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "1.5rem" },
        { "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
        { "slug": "60", "name": "XL", "size": "clamp(3.5rem, 8vw, 7rem)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--poppins)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "spacing": {
      "padding": { "left": "clamp(12px, 1.4vw, 22px)", "right": "clamp(12px, 1.4vw, 22px)", "top": "0", "bottom": "0" },
      "blockGap": "1.25rem"
    },
    "elements": {
      "heading": { "typography": { "fontWeight": "600", "lineHeight": "1.15" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--title)" } },
      "h3": { "typography": { "fontSize": "1.1rem" } },
      "link": { "color": { "text": "var(--wp--preset--color--contrast)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" },
        "border": { "radius": "0" },
        "typography": { "fontSize": "0.72rem", "fontWeight": "600", "letterSpacing": "0.22em", "textTransform": "uppercase" },
        "spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.9rem", "right": "1.9rem" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-titled", "title": "Page with title", "postTypes": ["page"] }
  ]
}
